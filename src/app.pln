route get "/"
    reply json
        name is "wyr-api"
        message is "template-generated would-you-rather questions"
        usage is "GET /api/wyr?level=good&sessionId=optional"
    done
done

route get "/api/health"
    remember rows as query
        SELECT COUNT(*)::int AS questions FROM questions
    done
    reply json
        ok is true
        questions is rows[0].questions
        levels is list with "good", "spicy", "18+" done
        storage is "postgres"
    done
done

route get "/api/stats"
    remember totals as query
        SELECT level, COUNT(*)::int AS count FROM questions GROUP BY level ORDER BY level
    done
    remember history as query
        SELECT COUNT(*)::int AS count FROM question_history
    done
    reply json
        questionsByLevel is totals
        historyRows is history[0].count
        templates is true
        deduplication is "sha256 fingerprint plus database uniqueness"
    done
done

route get "/api/levels"
    reply json
        levels is list with "good", "spicy", "18+" done
        note is "leave level off for a random category; add sessionId to avoid repeats for that session"
    done
done

route get "/api/wyr"
    remember requestedLevel as clean(coalesce(query("level"), ""))
    if requestedLevel is empty
        set requestedLevel to randomChoice(list with "good", "spicy", "18+" done)
    done
    if not (requestedLevel is "good" or requestedLevel is "spicy" or requestedLevel is "18+")
        status 400
        reply json
            error is "level must be good, spicy, or 18+"
            received is requestedLevel
            levels is list with "good", "spicy", "18+" done
        done
        return
    done

    remember sessionId as trim(coalesce(query("sessionId"), ""))
    if length(sessionId) is greater than 128
        status 400
        reply json
            error is "sessionId must be 128 characters or fewer"
        done
        return
    done

    remember selected as ""
    remember selectedRow as record with id "" and level "" and question "" and option_a "" and option_b "" done
    for index attempt from 1 to 80
        if selected is empty
            remember candidate as candidateFor(requestedLevel)
            if attempt is greater than 50
                set candidate to curatedFor(requestedLevel)
            done
            if valid(candidate)
                remember candidateId as candidate.id
                remember candidateLevel as candidate.level
                remember candidateQuestion as candidate.question
                remember candidateA as candidate.optionA
                remember candidateB as candidate.optionB
                remember candidateFingerprint as fingerprint(candidateLevel, candidateA, candidateB)
                remember candidateSource as candidate.source
                if sessionId is empty
                    remember claimed as query
                        WITH inserted AS (
                            INSERT INTO questions (id, level, question, option_a, option_b, fingerprint, source)
                            VALUES ({candidateId}, {candidateLevel}, {candidateQuestion}, {candidateA}, {candidateB}, {candidateFingerprint}, {candidateSource})
                            ON CONFLICT (fingerprint) DO NOTHING
                            RETURNING id, level, question, option_a, option_b
                        )
                        SELECT id, level, question, option_a, option_b FROM inserted
                        UNION ALL
                        SELECT id, level, question, option_a, option_b FROM questions WHERE fingerprint = {candidateFingerprint}
                        LIMIT 1
                    done
                    if length(claimed) is greater than 0
                        set selectedRow to claimed[0]
                        set selected to selectedRow.id
                    done
                otherwise
                    remember claimed as query
                        WITH inserted AS (
                            INSERT INTO questions (id, level, question, option_a, option_b, fingerprint, source)
                            VALUES ({candidateId}, {candidateLevel}, {candidateQuestion}, {candidateA}, {candidateB}, {candidateFingerprint}, {candidateSource})
                            ON CONFLICT (fingerprint) DO NOTHING
                            RETURNING id, level, question, option_a, option_b
                        ), pool AS (
                            SELECT id, level, question, option_a, option_b FROM inserted
                            UNION ALL
                            SELECT id, level, question, option_a, option_b FROM questions WHERE fingerprint = {candidateFingerprint}
                        ), unseen AS (
                            SELECT p.* FROM pool p
                            WHERE NOT EXISTS (
                                SELECT 1 FROM question_history h
                                WHERE h.session_id = {sessionId}
                                AND h.level = {requestedLevel}
                                AND h.question_id = p.id
                            )
                            LIMIT 1
                        ), marked AS (
                            INSERT INTO question_history (session_id, level, question_id)
                            SELECT {sessionId}, {requestedLevel}, id FROM unseen
                            ON CONFLICT (session_id, level, question_id) DO NOTHING
                            RETURNING question_id
                        )
                        SELECT unseen.id, unseen.level, unseen.question, unseen.option_a, unseen.option_b
                        FROM unseen JOIN marked ON marked.question_id = unseen.id
                    done
                    if length(claimed) is greater than 0
                        set selectedRow to claimed[0]
                        set selected to selectedRow.id
                    done
                done
            done
        done
    done

    if selected is empty
        status 409
        reply json
            error is "no unseen questions are currently available for this category"
            level is requestedLevel
            hint is "try another level or use a new sessionId"
        done
        return
    done
    reply json
        id is selectedRow.id
        level is selectedRow.level
        question is selectedRow.question
        optionA is selectedRow.option_a
        optionB is selectedRow.option_b
    done
done

when nothing matches
    status 404
    reply json
        error is "not found"
        tryThis is "GET /api/wyr?level=good&sessionId=demo"
    done
done

start env("PORT")
