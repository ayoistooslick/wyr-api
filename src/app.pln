// wyr-api question engine. still hobby code, just a little more serious now.
// no AI calls. the questions come from compatible pieces and templates.
import { createHash } from "crypto"
web app
allow cors
postgres env("DATABASE_URL")

execute
    CREATE TABLE IF NOT EXISTS questions (
        id TEXT PRIMARY KEY,
        level TEXT NOT NULL CHECK (level IN ('good', 'spicy', '18+')),
        question TEXT NOT NULL,
        option_a TEXT NOT NULL,
        option_b TEXT NOT NULL,
        fingerprint TEXT NOT NULL UNIQUE,
        source TEXT NOT NULL,
        created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    )
done
execute
    CREATE TABLE IF NOT EXISTS question_history (
        session_id TEXT NOT NULL,
        level TEXT NOT NULL CHECK (level IN ('good', 'spicy', '18+')),
        question_id TEXT NOT NULL REFERENCES questions(id),
        served_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
        PRIMARY KEY (session_id, level, question_id)
    )
done
execute
    CREATE INDEX IF NOT EXISTS question_history_session_level_idx
    ON question_history (session_id, level, served_at)
done
execute
    CREATE INDEX IF NOT EXISTS questions_level_idx ON questions (level)
done

make clean(text)
    give regexReplace(lowercase(trim(text)), "\\s+", " ").replaceAll("?", "").replaceAll(".", "").replaceAll(",", "").replaceAll("!", "").replaceAll(":", "")
done

make fingerprint(level, optionA, optionB)
    remember a as clean(optionA)
    remember b as clean(optionB)
    remember first as a
    remember second as b
    if b is less than a
        set first to b
        set second to a
    done
    give createHash("sha256").update(clean(level) + "|" + first + "|" + second).digest("hex")
done

make valid(candidate)
    if length(trim(candidate.question)) is less than 20
        give false
    done
    if length(trim(candidate.optionA)) is 0 or length(trim(candidate.optionB)) is 0
        give false
    done
    if clean(candidate.optionA) is clean(candidate.optionB)
        give false
    done
    if not (candidate.question contains candidate.optionA)
        give false
    done
    if not (candidate.question contains candidate.optionB)
        give false
    done
    give true
done

make fromComponent(level, component)
    remember optionA as ""
    remember optionB as ""
    remember question as ""
    if component.shape is "pair"
        set optionA to component.left
        set optionB to component.right
        set question to `Would you rather ${optionA} or ${optionB}?`
    otherwise if component.shape is "consequence"
        set optionA to component.left
        set optionB to component.right
        set question to `Would you rather ${optionA}, even if ${component.consequenceA}, or ${optionB}, even if ${component.consequenceB}?`
    otherwise
        set optionA to component.actionA
        set optionB to component.actionB
        set question to `Would you rather always ${optionA} or never ${optionB}?`
    done
    give record with id uuid() and level level and question question and optionA optionA and optionB optionB and source "template" done
done

make candidateFor(level)
    if level is "good"
        give fromComponent(level, randomChoice(goodComponents))
    otherwise if level is "spicy"
        give fromComponent(level, randomChoice(spicyComponents))
    otherwise
        give fromComponent(level, randomChoice(adultComponents))
    done
done

make curatedFor(level)
    if level is "good"
        give randomChoice(goodQuestions)
    otherwise if level is "spicy"
        give randomChoice(spicyQuestions)
    otherwise
        give randomChoice(adultQuestions)
    done
done

remember goodComponents as list with
    record with shape "pair" and category "food" and left `have free coffee forever` and right `have free pizza forever` done
    record with shape "pair" and category "lifestyle" and left `never do laundry again` and right `never wash dishes again` done
    record with shape "pair" and category "travel" and left `visit every country once` and right `visit one country every year` done
    record with shape "pair" and category "money" and left `get $500 every month` and right `get $50,000 once` done
    record with shape "pair" and category "technology" and left `have perfect Wi-Fi everywhere` and right `have unlimited phone battery` done
    record with shape "pair" and category "hobbies" and left `be amazing at drawing` and right `be amazing at singing` done
    record with shape "pair" and category "social" and left `always know what to say` and right `always know when to stay quiet` done
    record with shape "pair" and category "home" and left `live in a tiny perfect apartment` and right `live in a huge messy house` done
    record with shape "pair" and category "food" and left `only eat breakfast foods` and right `only eat dinner foods` done
    record with shape "pair" and category "experience" and left `watch your favorite movie for the first time again` and right `read your favorite book for the first time again` done
    record with shape "consequence" and category "money" and left `have a job you love` and right `earn twice as much but dislike your coworkers` and consequenceA `love your work but have a long commute` and consequenceB `earn more but dread Mondays` done
    record with shape "consequence" and category "travel" and left `take a free trip anywhere` and right `take a free staycation with every comfort` and consequenceA `travel tomorrow with no plan` and consequenceB `stay home with everything delivered` done
    record with shape "consequence" and category "technology" and left `give up social media` and right `give up streaming services` and consequenceA `have more free time but miss updates` and consequenceB `have endless shows but no scrolling` done
    record with shape "consequence" and category "food" and left `eat your favorite meal every day` and right `never eat your favorite meal again` and consequenceA `never get bored of it` and consequenceB `always wonder what you are missing` done
    record with shape "consequence" and category "friendship" and left `always have one brutally honest friend` and right `always have ten supportive friends` and consequenceA `hear hard truths` and consequenceB `never be short on encouragement` done
    record with shape "action" and category "hypothetical" and actionA `always wake up fully rested` and actionB `never need to sleep` done
    record with shape "action" and category "hypothetical" and actionA `be able to pause time for one hour a day` and actionB `be able to rewind your last ten minutes` done
    record with shape "action" and category "hobbies" and actionA `master every board game` and actionB `master every video game` done
    record with shape "action" and category "lifestyle" and actionA `always have perfect weather on weekends` and actionB `always have perfect weather on holidays` done
    record with shape "action" and category "social" and actionA `make everyone laugh` and actionB `make everyone feel understood` done
done
